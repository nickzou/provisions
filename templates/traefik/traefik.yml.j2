api:
  dashboard: false

log:
  level: INFO

providers:
  docker:
    exposedByDefault: false
    network: proxy

entryPoints:
  web:
    address: ":80"
    http:
      redirections:
        entryPoint:
          to: websecure
          scheme: https
  websecure:
    address: ":443"

certificatesResolvers:
  letsencrypt:
    acme:
{% if traefik_acme_email %}
      email: "{{ traefik_acme_email }}"
{% endif %}
      storage: /acme.json
      httpChallenge:
        entryPoint: web
